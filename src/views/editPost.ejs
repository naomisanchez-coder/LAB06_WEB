<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Post</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body {
            background: linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Roboto, sans-serif;
            color: #4a4a4a;
            padding: 20px 0;
        }
        .edit-container {
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(12px);
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.6);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.08);
            max-width: 600px;
            width: 100%;
        }
        .title-edit {
            color: #4a4e69;
            font-weight: 700;
        }
        .form-control {
            border-radius: 12px;
            border: 1px solid #dcd6f7;
            background-color: #fcfaff;
            padding: 12px;
        }
        .form-control:focus {
            border-color: #b8c6db;
            box-shadow: 0 0 8px rgba(184, 198, 219, 0.5);
            background-color: #ffffff;
        }
        .btn-save-pastel {
            background: linear-gradient(135deg, #81acec 0%, #7bf0c2 100%);
            color: #1e293b;
            font-weight: 600;
            border: none;
            border-radius: 12px;
            padding: 10px 24px;
        }
        .btn-save-pastel:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(129, 172, 236, 0.4);
            color: #0f172a;
        }
        .btn-cancel-pastel {
            background-color: #dfe6e9;
            color: #636e72;
            font-weight: 600;
            border: none;
            border-radius: 12px;
            padding: 10px 24px;
        }
        .btn-cancel-pastel:hover {
            background-color: #b2bec3;
            color: #2d3436;
        }
    </style>
</head>
<body>
    <div class="edit-container p-4 p-md-5">
        <h2 class="mb-4 title-edit text-center">Editar Publicación</h2>
        <form action="/posts/update/<%= post._id %>" method="POST">
            <div class="mb-3">
                <label class="form-label fw-bold text-secondary">Título</label>
                <input type="text" name="title" value="<%= post.title %>" class="form-control" required>
            </div>
            <div class="mb-4">
                <label class="form-label fw-bold text-secondary">Contenido</label>
                <textarea name="content" class="form-control" rows="4" required><%= post.content %></textarea>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-save-pastel">Guardar Cambios</button>
                <a href="/posts" class="btn btn-cancel-pastel">Cancelar</a>
            </div>
        </form>
    </div>
</body>
</html>